  #
  # Duco WTW scan per 300 seconden
  #

  - resource: http://192.168.1.73/nodeconfigget?node=58
    scan_interval: 65
    timeout: 15
    verify_ssl: false
    sensor:
    - name: "DucoBox node58 configget"
      unique_id: ducobox_node58_configget
      icon: mdi:fan
      value_template: "node: {{ value_json.node }}"
      json_attributes:
      - RHSetpoint
  #    - RHDelta
  #    - Manual1
  #    - Manual2
  #    - Manual3
  #    - ManualTimeout
  #    - SensorVisuLevel
  #    - UcErrorMode
