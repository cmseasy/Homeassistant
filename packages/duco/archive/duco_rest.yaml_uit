# Voor de scan interval worden priemgetallen gebruikt om overlapping te vermijden
# alle atributen staan onder de sensor, niet gebruikte worden voorzien van een comment #
rest:

  # Ducobox
  - resource: http://192.168.1.73/boxinfoget
    scan_interval: 11
    timeout: 15
    verify_ssl: false 
    sensor:
    - name: "DucoBox boxinfoget"
      unique_id: ducobox_boxinfoget
      icon: mdi:fan
      value_template: " OK "
      json_attributes:
  #    - General
  #    - EnergyInfo
      - EnergyFan
  #    - EnergyCalib
  #    - NightBoostInfo
      - VentCoolInfo

  - resource: http://192.168.1.73/boxinfoget
    scan_interval: 13
    timeout: 15
    verify_ssl: false 
    sensor:
    - name: "DucoBox boxinfoget 2"
      unique_id: ducobox_boxinfoget_2
      icon: mdi:fan
      value_template: " OK "
      json_attributes:
  #    - General
      - EnergyInfo
  #    - EnergyFan
  #    - EnergyCalib
      - NightBoostInfo
      - VentCoolInfo

  # Ducobox configuration
  - resource: http://192.168.1.73/boxconfigget
    scan_interval: 61
    timeout: 15
    verify_ssl: false 
    sensor:
    - name: "DucoBox boxconfigget"
      unique_id: ducobox_boxconfigget
      icon: mdi:fan
      value_template: " OK "
      json_attributes:
  #    - Time
  #    - Settings
  #    - Energy
      - VentCtrl
  #    - VentCool
  #    - NightBoost
  #    - Modbus
  #    - Ethernet







  # Ducobox node 1
  - resource: http://192.168.1.73/nodeinfoget?node=1
    scan_interval: 17
    timeout: 15
    verify_ssl: false
    sensor:
    - name: "DucoBox node 1"
      unique_id: ducobox
      icon: mdi:fan
      value_template: "{{ value_json.state }}"
      json_attributes:
  #      - node
  #      - devtype
  #      - subtype
  #      - netw
  #      - addr
  #      - sub
  #      - prnt
  #      - asso
  #      - location
        - state
        - cntdwn
  #      - endtime
  #      - mode
  #      - trgt
  #      - actl
  #      - ovrl
  #      - snsr
  #      - cerr
  #      - swversion
  #      - serialnb
        - temp
  #      - co2
        - rh
  #      - error
  #      - show
  #      - link

  # Kleppen wonen
  - resource: http://192.168.1.73/nodeinfoget?node=2
    scan_interval: 31
    timeout: 15
    verify_ssl: false
    sensor:
    - name: "Duco zoneklep wonen"
      unique_id: valve_zone_1
      icon: mdi:fan
      value_template: "{{ value_json.state }}"
      json_attributes:
  #      - node
  #      - devtype
  #      - subtype
  #      - netw
  #      - addr
  #      - sub
  #      - prnt
  #      - asso
  #      - location
        - state
        - cntdwn
  #      - endtime
  #      - mode
  #      - ovrl
  #      - snsr
  #      - cerr
  #      - swversion
  #      - serialnb
  #      - error
  #      - show
  #      - link

  # Kleppen slapen
  - resource: http://192.168.1.73/nodeinfoget?node=3
    scan_interval: 37
    timeout: 15
    verify_ssl: false
    sensor:
    - name: "Duco zoneklep slapen"
      unique_id: valve_zone_2
      icon: mdi:fan
      value_template: "{{ value_json.state }}"
      json_attributes:
  #      - node
  #      - devtype
  #      - subtype
  #      - netw
  #      - addr
  #      - sub
  #      - prnt
  #      - asso
  #      - location
        - state
        - cntdwn
  #      - endtime
  #      - mode
  #      - ovrl
  #      - snsr
  #      - cerr
  #      - swversion
  #      - serialnb
  #      - error
  #      - show
  #      - link

  # Bedieningssensor woonkamer
  - resource: http://192.168.1.73/nodeinfoget?node=4
    scan_interval: 19
    timeout: 15
    verify_ssl: false
    sensor:
    - name: "Duco bedieningssensor woonkamer"
      unique_id: duco_bedieningssensor_woonkamer
      icon: mdi:fan
      value_template: "node: {{ value_json.node }}"
      json_attributes:
        - node
  #      - devtype
  #      - subtype
  #      - netw
  #      - addr
  #      - sub
  #      - prnt
  #      - asso
  #      - location
  #      - state
  #      - cntdwn
  #      - endtime
  #      - mode
  #      - ovrl
  #      - snsr
  #      - cerr
  #      - swversion
  #      - serialnb
        - temp
        - co2
  #      - rh
  #      - rssi_n2m
  #      - hop_via
  #      - rssi_n2h
  #      - error
  #      - show
  #      - link

  # Sensor slaapkamer
