    scan_interval: 23
    timeout: 15
    verify_ssl: false
    sensor:
    - name: "Duco bedieningssensor slaapkamer"
      unique_id: duco_bedieningssensor_slaapkamer
      icon: mdi:fan
      value_template: "node: {{ value_json.node }}"
      json_attributes:
  #      - node
  #      - devtype
  #      - subtype
  #      - netw
  #      - addr
  #      - sub
  #      - prnt
  #      - asso
  #      - location
  #      - state
  #      - cntdwn
  #      - endtime
  #      - mode
  #      - ovrl
  #      - snsr
  #      - cerr
  #      - swversion
  #      - serialnb
        - temp
        - co2
