alias: "WP koelen: dauwpuntregeling (outlet)"
description: ""
triggers:
  - trigger: time_pattern
    minutes: /1
    id: periodiek
  - trigger: state
    entity_id:
      - input_select.wp_selecteer_bedrijfsmodus
    to:
      - Auto koelen
    for:
      hours: 0
      minutes: 0
      seconds: 5
  - trigger: state
    entity_id:
      - binary_sensor.adlar_compressor_active
    from:
      - "off"
    to:
      - "on"
    id: Compressor gestart 10 sec geleden
    enabled: true
    for:
      hours: 0
      minutes: 0
      seconds: 10
  - trigger: state
    entity_id:
      - binary_sensor.adlar_compressor_active
    from:
      - "off"
    to:
      - "on"
    id: Compressor gestart 1 min geleden
    enabled: true
    for:
      hours: 0
      minutes: 1
      seconds: 0
  - trigger: state
    entity_id:
      - binary_sensor.adlar_compressor_active
    from:
      - "on"
    to:
      - "off"
    id: Compressor gestopt
    enabled: true
    for:
      hours: 0
      minutes: 0
      seconds: 5
  - trigger: numeric_state
    entity_id:
      - sensor.adlar_water_outlet_temp_t7
    for:
      hours: 0
      minutes: 5
      seconds: 0
    below: sensor.dauwpunt_woonkamer
    id: Outlet temp < dauwpunt
  - entity_id:
      - sensor.dauwpunt_woonkamer
    for:
      hours: 0
      minutes: 0
      seconds: 1
    enabled: false
    from: null
    to: null
    trigger: state
  - trigger: state
    entity_id:
      - sensor.adlar_water_outlet_temp_t7
    for:
      hours: 0
      minutes: 1
      seconds: 0
    from: null
    to: null
    enabled: false
conditions:
  - condition: state
    entity_id: switch.adlar_main_switch
    state:
      - "on"
  - condition: state
    entity_id: select.adlar_mode
    state:
      - Cooling
  - condition: state
    entity_id: select.adlar_cooling_setting_curve
    state:
      - "Off"
  - condition: state
    entity_id: timer.wachttijd_koelcurve_veranderen
    state: idle
  - condition: state
    entity_id: input_select.wp_selecteer_bedrijfsmodus
    state:
      - Auto koelen
  - condition: template
    value_template: "{{ is_state_attr('switch.schedule_d94a8d', 'current_slot', none) }}"
    enabled: true
  - condition: state
    entity_id: select.adlar_p116_regeling_in_of_outlet
    state:
      - Outlet
actions:
  - choose:
      - conditions:
          - condition: numeric_state
            entity_id: sensor.kamertemperatuur_gemiddeld
            above: 23
          - condition: numeric_state
            entity_id: sensor.dauwpunt_woonkamer
            below: 20
            enabled: true
          - condition: trigger
            id:
              - periodiek
          - condition: state
            entity_id: switch.schedule_d94a8d
            state:
              - "on"
        sequence:
          - repeat:
              while:
                - condition: state
                  entity_id: binary_sensor.adlar_compressor_active
                  state:
                    - "off"
                  for:
                    hours: 0
                    minutes: 45
                    seconds: 0
                - condition: numeric_state
                  entity_id: sensor.adlar_water_outlet_temp_t7
                  value_template: "{{ float(state.state) }}"
                  above: sensor.dauwpunt_woonkamer
                - condition: timer.is_idle
                  target:
                    entity_id: timer.wachttijd_temp_set_veranderen
                  options:
                    for: "00:00:00"
              sequence:
                - action: number.set_value
                  target:
                    entity_id: number.adlar_temp_set_cooling
                  data:
                    value: >-
                      {% set dauwpunt = states('sensor.dauwpunt_woonkamer') |
                      float(0) | round(0, 'ceil') %}

                      {% set delta_t_aan =
                      states('sensor.wp_aan_delta_t_temp_set') | float(0) |
                      round(0, 'ceil') %}

                      {% set doel_temp = (dauwpunt - (delta_t_aan | abs) - 1) |
                      int %} 

                      {% set temp_set = states('number.adlar_temp_set_cooling')
                      | int(0) %}

                      {% if temp_set > doel_temp %}
                        {{ temp_set - 1 }}
                      {% else %}
                        {{ temp_set }}
                      {% endif %}
                - delay:
                    hours: 0
                    minutes: 0
                    seconds: 20
                    milliseconds: 0
                - action: logbook.log
                  data:
                    name: Adlar automation
                    message: >
                      {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                      float(0) | round(0,'ceil') %}

                      {% set temp_set = states('number.adlar_temp_set_cooling')
                      | int(0) %} 

                      Wp koelen (outlet) 1a Temp set -1 van {{ temp_set }} naar
                      {{ temp_set -1 }}
                    entity_id: number.adlar_temp_set_cooling
                  enabled: true
                - delay:
                    hours: 0
                    minutes: 3
                    seconds: 0
                    milliseconds: 0
            enabled: true
          - variables:
              dauwpunt: >-
                {{ states('sensor.dauwpunt_woonkamer') | float(0) | round(0,
                'ceil') }}
              temp_set: "{{ states('number.adlar_temp_set_cooling') | int(0) }}"
              temp_buiten: "{{ states('sensor.buitentemperatuur_gemiddeld') | float(0) }}"
              max_temp_set: >-
                {% if temp_buiten < 23 %} 18 {% elif 23 <= temp_buiten < 25 %}
                17 {% elif 25 <= temp_buiten < 27 %} 16 {% elif 27 <=
                temp_buiten < 29 %} 15 {% elif 29 <= temp_buiten < 31 %} 14  {%
                elif 31 <= temp_buiten < 33 %} 13 {% else %} 10 {% endif %}
              new_temp_set: "{{ [dauwpunt, max_temp_set | int] | max }}"
          - if:
              - condition: template
                value_template: "{{ temp_set != new_temp_set | int }}"
            then:
              - action: number.set_value
                target:
                  entity_id: number.adlar_temp_set_cooling
                data:
                  value: "{{ new_temp_set }}"
              - delay:
                  hours: 0
                  minutes: 0
                  seconds: 20
                  milliseconds: 0
              - action: logbook.log
                data:
                  name: Adlar automation
                  message: >
                    {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                    float(0) | round(0,'ceil') %}

                    {% set temp_set = states('number.adlar_temp_set_cooling') |
                    int(0) %}

                    Wp koelen (outlet) 1b dauwpunt temp set: van {{ temp_set }}
                    naar {{ dauwpunt + 0 }} 
                  entity_id: number.adlar_temp_set_cooling
                enabled: true
              - action: timer.start
                metadata: {}
                data:
                  duration:
                    hours: 0
                    minutes: 2
                    seconds: 0
                target:
                  entity_id: timer.wachttijd_temp_set_veranderen
                enabled: true
          - alias: Temp set bij start kouderegeling
            target:
              entity_id: number.adlar_temp_set_cooling
            data:
              value: >-
                {% set dauwpunt = states('sensor.dauwpunt_woonkamer') | float(0)
                | round(0, 'ceil') %}

                {% set temp_set = states('number.adlar_temp_set_cooling') |
                int(0) %} 

                {% set temp_buiten =
                states('sensor.buitentemperatuur_gemiddeld') | float(0)  %}


                {% if temp_buiten < 23 %}
                  {% set max_temp_set = 20 %}
                {% elif  23 <= temp_buiten < 25  %}
                  {% set max_temp_set = 19 %}
                {% elif  25 <= temp_buiten < 27  %}
                  {% set max_temp_set = 18 %}
                {% elif  27 <= temp_buiten < 29  %}
                  {% set max_temp_set = 17 %}
                {% elif 29 <= temp_buiten < 31  %}
                  {% set max_temp_set = 16 %}
                {% elif 31 <= temp_buiten < 33  %}
                  {% set max_temp_set = 15 %}
                {% else %}
                   {% set max_temp_set = 10 %}
                {% endif %}


                {% if temp_set != [dauwpunt, max_temp_set] | max  %}

                {{ [dauwpunt, max_temp_set] | max }}

                {% else %}
                  {{ temp_set }}
                {% endif %}
            action: number.set_value
            enabled: false
      - conditions:
          - condition: trigger
            id:
              - Compressor gestart 1 min geleden
        sequence:
          - variables:
              dauwpunt: >-
                {{ states('sensor.dauwpunt_woonkamer') | float(0) | round(0,
                'ceil') }}
              temp_set: "{{ states('number.adlar_temp_set_cooling') | int(0) }}"
              temp_buiten: "{{ states('sensor.buitentemperatuur_gemiddeld') | float(0) }}"
              max_temp_set: >-
                {% if temp_buiten < 23 %} 20 {% elif 23 <= temp_buiten < 25 %}
                19 {% elif 25 <= temp_buiten < 27 %} 18 {% elif 27 <=
                temp_buiten < 29 %} 17 {% elif 29 <= temp_buiten < 31 %} 16  {%
                elif 31 <= temp_buiten < 33 %} 15 {% else %} 10 {% endif %}
              new_temp_set: "{{ [dauwpunt, max_temp_set | int] | max }}"
          - if:
              - condition: template
                value_template: "{{ temp_set != new_temp_set | int }}"
            then:
              - action: number.set_value
                target:
                  entity_id: number.adlar_temp_set_cooling
                data:
                  value: "{{ new_temp_set }}"
              - action: timer.start
                metadata: {}
                data:
                  duration:
                    hours: 0
                    minutes: 10
                    seconds: 0
                target:
                  entity_id: timer.wachttijd_temp_set_veranderen
                enabled: true
              - delay:
                  hours: 0
                  minutes: 0
                  seconds: 20
                  milliseconds: 0
              - action: logbook.log
                data:
                  name: Adlar automation
                  message: >
                    {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                    float(0) | round(0,'ceil') %} {% set temp_set =
                    states('number.adlar_temp_set_cooling') | int(0) %} Wp
                    koelen (outlet) 2 temp set: van {{ temp_set }} naar {{
                    dauwpunt + 0 }} 
                  entity_id: number.adlar_temp_set_cooling
                enabled: true
          - alias: Temp set bij start kouderegeling
            target:
              entity_id: number.adlar_temp_set_cooling
            data:
              value: >+
                {% set dauwpunt = states('sensor.dauwpunt_woonkamer') | float(0)
                | round(0, 'ceil') %}

                {% set temp_set = states('number.adlar_temp_set_cooling') |
                int(0) %} 

                {% if temp_set != dauwpunt %}

                {{ [dauwpunt + 0, 15] | max }}

                {% else %}
                  {{ temp_set }}
                {% endif %}


            action: number.set_value
            enabled: false
      - conditions:
          - condition: trigger
            id:
              - Outlet temp < dauwpunt
          - condition: state
            entity_id: binary_sensor.adlar_compressor_active
            state:
              - "on"
          - condition: state
            entity_id: timer.wachttijd_temp_set_veranderen
            state:
              - idle
          - condition: numeric_state
            entity_id: sensor.wp_delta_t
            below: -2
          - condition: numeric_state
            entity_id: sensor.adlar_compressor_running_frequency
            above: 30
            enabled: true
            below: 35
          - condition: numeric_state
            entity_id: sensor.adlar_water_outlet_temp_t7
            below: sensor.dauwpunt_woonkamer
            enabled: false
        sequence:
          - alias: Temp set bij start kouderegeling
            target:
              entity_id: number.adlar_temp_set_cooling
            data:
              value: >-
                {% set temp_set = states('number.adlar_temp_set_cooling') |
                int(0) %}

                {{ [temp_set + 1, 15] | max }}
            action: number.set_value
            enabled: true
          - action: logbook.log
            metadata: {}
            data:
              name: Adlar automation
              entity_id: number.adlar_temp_set_cooling
              message: >-
                {% set delta_t_stop = states('sensor.wp_delta_t_bij_stop') |
                int(0) %}

                {% set p26 =
                states('sensor.adlar_p26_hysterese_watertemperatuur_start_warmtepomp')
                | int(0) %}

                {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                float(0) | round(0,'ceil') %}

                {% set temp_set = states('number.adlar_temp_set_cooling') |
                int(0) %}

                {% set outlet = states ('sensor.adlar_water_outlet_temp_t7') |
                int(0) %}

                Wp koelen (outlet) 3 temp set: van {{ temp_set }} naar {{
                temp_set + 1 }} 
            enabled: true
          - action: timer.start
            metadata: {}
            target:
              entity_id: timer.wachttijd_temp_set_veranderen
            data:
              duration:
                hours: 0
                minutes: 10
                seconds: 0
            enabled: true
      - conditions:
          - condition: state
            entity_id: switch.adlar_main_switch
            state:
              - "off"
          - condition: numeric_state
            entity_id: sensor.adlar_water_outlet_temp_t7
            value_template: "{{ float(state.state, 0) - 2 }}"
            enabled: true
            above: sensor.dauwpunt_woonkamer
          - condition: state
            entity_id: binary_sensor.adlar_compressor_active
            state:
              - "on"
            for:
              hours: 0
              minutes: 5
              seconds: 0
          - condition: state
            entity_id: timer.wachttijd_temp_set_veranderen
            state:
              - idle
        sequence:
          - alias: Temp set bij start kouderegeling
            target:
              entity_id: number.adlar_temp_set_cooling
            data:
              value: >-
                {{((states ('number.adlar_temp_set_cooling') | int(0) - 1), 17)
                | max }}
            action: number.set_value
            enabled: false
          - action: logbook.log
            metadata: {}
            data:
              name: Adlar automation
              entity_id: number.adlar_temp_set_cooling
              message: >-
                WP kouderegeling dauwpunt (outlet) - optie 4, temp set: {{
                states('number.adlar_temp_set_cooling') }} - 1
            enabled: false
          - action: timer.start
            metadata: {}
            target:
              entity_id: timer.wachttijd_temp_set_veranderen
            data:
              duration:
                hours: 0
                minutes: 10
                seconds: 0
            enabled: false
      - conditions:
          - condition: template
            value_template: >-
              {% set dauwpunt = states('sensor.dauwpunt_woonkamer') | float(0) |
              round(0, 'ceil') %}

              {% set delta_t_aan = states('sensor.wp_aan_delta_t_temp_set') |
              float(0) | round(0, 'ceil') %}

              {% set doel_temp = (dauwpunt - (delta_t_aan | abs) - 1) | int %}

              {{ states('number.adlar_temp_set_cooling') | int(0) != doel_temp
              }}
            enabled: false
          - condition: trigger
            id:
              - Compressor gestopt
        sequence:
          - alias: Temp set bij start kouderegeling
            target:
              entity_id: number.adlar_temp_set_cooling
            data:
              value: >
                {% set delta_t_stop = states('sensor.wp_delta_t_bij_stop') |
                int(0) %}

                {% set p26 =
                states('sensor.adlar_p26_hysterese_watertemperatuur_start_warmtepomp')
                | int(0) %}

                {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                float(0) | round(0,'ceil') %}

                {% set temp_set = states('number.adlar_temp_set_cooling') |
                int(0) %}

                {% set outlet = states ('sensor.adlar_water_outlet_temp_t7') |
                int(0) %}

                {% set delta_t_aan = states ('sensor.wp_aan_delta_t_temp_set') |
                float(0) | round(0,'ceil') %}

                {# Als het verschil kleiner is dan 0, laat dan de delta zien,
                anders 0 #}

                {% if dauwpunt - (delta_t_aan | abs) - 1 != temp_set  %}
                  {{ dauwpunt - (delta_t_aan | abs) - 1 }}
                {#% else %#}

                {% endif %}
            action: number.set_value
            enabled: false
          - action: logbook.log
            data:
              name: Adlar automation
              message: >+
                {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                float(0) | round(0,'ceil') %}

                {% set temp_set = states('number.adlar_temp_set_cooling') |
                int(0) %}

                {% set outlet = states ('sensor.adlar_water_outlet_temp_t7') |
                int(0) %}

                {% set delta_t_aan = states ('sensor.wp_aan_delta_t_temp_set') |
                float(0) | round(0,'ceil') %}

                Wp koelen (outlet) 5  Compressor gestopt, Temp set {{ temp_set
                }} 

              entity_id: number.adlar_temp_set_cooling
            enabled: true
mode: single
