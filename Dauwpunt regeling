alias: 'WP koelen: dauwpuntregeling (outlet)'
description: ''
triggers:
  - trigger: time_pattern
    minutes: /30
    id: periodiek
    enabled: true
  - trigger: state
    entity_id:
      - input_select.wp_selecteer_bedrijfsmodus
    to:
      - Auto koelen
    for:
      hours: 0
      minutes: 0
      seconds: 5
  - trigger: state
    entity_id:
      - binary_sensor.adlar_compressor_active
    from:
      - 'off'
    to:
      - 'on'
    id: Compressor gestart 10 sec geleden
    enabled: true
    for:
      hours: 0
      minutes: 0
      seconds: 10
  - trigger: state
    entity_id:
      - binary_sensor.adlar_compressor_active
    from:
      - 'off'
    to:
      - 'on'
    id: Compressor gestart 1 min geleden
    enabled: true
    for:
      hours: 0
      minutes: 1
      seconds: 0
  - trigger: state
    entity_id:
      - binary_sensor.adlar_compressor_active
    from:
      - 'on'
    to:
      - 'off'
    id: Compressor gestopt
    enabled: true
    for:
      hours: 0
      minutes: 0
      seconds: 5
  - trigger: numeric_state
    entity_id:
      - sensor.adlar_water_outlet_temp_t7
    for:
      hours: 0
      minutes: 5
      seconds: 0
    below: sensor.dauwpunt_woonkamer
    id: Outlet temp < dauwpunt
  - entity_id:
      - sensor.dauwpunt_woonkamer
    for:
      hours: 0
      minutes: 0
      seconds: 1
    enabled: true
    from: null
    to: null
    trigger: state
    id: Dauwpunt
  - trigger: state
    entity_id:
      - sensor.adlar_water_outlet_temp_t7
    for:
      hours: 0
      minutes: 1
      seconds: 0
    from: null
    to: null
    enabled: true
    id: Outlet
conditions:
  - condition: state
    entity_id: switch.adlar_main_switch
    state:
      - 'on'
  - condition: state
    entity_id: select.adlar_mode
    state:
      - Cooling
  - condition: state
    entity_id: select.adlar_cooling_setting_curve
    state:
      - 'Off'
  - condition: state
    entity_id: timer.wachttijd_koelcurve_veranderen
    state: idle
  - condition: state
    entity_id: input_select.wp_selecteer_bedrijfsmodus
    state:
      - Auto koelen
  - condition: template
    value_template: '{{ is_state_attr(''switch.schedule_d94a8d'', ''current_slot'', none) }}'
    enabled: true
  - condition: state
    entity_id: select.adlar_p116_regeling_in_of_outlet
    state:
      - Outlet
