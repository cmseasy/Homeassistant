                    hours: 0
                    minutes: 0
                    seconds: 20
                    milliseconds: 0
                - action: logbook.log
                  data:
                    name: Adlar automation
                    message: >
                      {% set dauwpunt = states ('sensor.dauwpunt_woonkamer') |
                      float(0) | round(0,'ceil') %}

                      {% set temp_set = states('number.adlar_temp_set_cooling')
                      | int(0) %} 

                      Wp koelen (outlet) 1a Temp set -1 van {{ temp_set }} naar
                      {{ temp_set -1 }}
                    entity_id: number.adlar_temp_set_cooling
                  enabled: true
                - delay:
                    hours: 0
                    minutes: 3
                    seconds: 0
                    milliseconds: 0
            enabled: true
          - variables:
